{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feng-regras",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://SEU-USUARIO.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "feng-regras",
    "database_id": "PREENCHER-ID-DO-D1",
    "migrations_dir": "migrations"
  }]
}
